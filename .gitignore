# ==========================================
# ClipGrab Monorepo Comprehensive .gitignore
# ==========================================

# 📦 Dependencies & Package Management
node_modules/
**/node_modules/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🏗️ Build & Bundler Outputs (Turborepo, Vite, Webpack)
dist/
**/dist/
build/
**/build/
out/
**/out/
.turbo/
**/.turbo/
.cache/
**/.cache/
coverage/
**/coverage/
*.tsbuildinfo

# 🖥️ Apps: Desktop (Tauri v2 / Rust)
target/
**/target/
**/src-tauri/target/
**/src-tauri/gen/
*.pdb
*.exe
*.dylib
*.so
*.dll

# 🌐 Apps: Extension (WebExtension / Vite)
*.crx
*.pem

# 📱 Apps: Mobile (Expo / React Native / iOS / Android)
.expo/
**/.expo/
.expo-shared/
web-build/
**/web-build/
*.orig.*

# Android native build files
android/app/build/
android/.gradle/
android/build/
*.apk
*.aab

# iOS native build files
ios/Pods/
ios/build/
*.xcworkspace
*.xcodeproj/project.xcworkspace
*.ipa

# 🔐 Environment / Secrets
.env
.env.*
!.env.example

# 🎬 Media & Downloader Outputs
*.mp4
*.mp3
*.mov
*.mkv
*.avi
*.webm
*.flv

# 🍪 Cookies & Process Logs
*.cookies
cookies.txt
*.log

# 💻 OS & IDE Files
.DS_Store
**/.DS_Store
Thumbs.db
**/.Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

